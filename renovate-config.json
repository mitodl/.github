{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "extends": [
    ":automergeMinor",
    ":rebaseStalePrs",
    ":separateMajorReleases",
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "7 days"
  },
  "schedule": [
    "every weekend"
  ],
  "timezone": "US/Eastern",
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)prek\\.toml$"
      ],
      "matchStrings": [
        "repo\\s*=\\s*[\"']https://github\\.com/(?<depName>[^\"']+)[\"'][\\s\\S]*?rev\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Earthfile",
        "*.Dockerfile",
        "Dockerfile.*",
        "*.dockerfile"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "automerge": false
    },
    {
      "groupName": "all non-major dev-dependencies",
      "groupSlug": "all-minor-dev-patch",
      "matchPackagePatterns": [
        "*"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchSourceUrlPrefixes": [
        "https://github.com/ckeditor/ckeditor5/"
      ],
      "groupName": "ckeditor5"
    },
    {
      "matchPackageNames": [
        "xmlsec"
      ],
      "allowedVersions": "!/1\\.3\\.14/",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "automerge": false
    },
    {
      "description": "Our own PyPI packages skip the release-age wait, matching each repo's [tool.uv.exclude-newer-package] list, so apps pick up our fixes as soon as they are released.",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "mitol-*",
        "ol-*",
        "django-aqueduct",
        "edx-api-client",
        "edx-sysadmin",
        "edx-username-changer",
        "openedx-companion-auth",
        "rapid-response-xblock"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Our own npm packages skip the release-age wait. ol-* is PyPI-only because unscoped ol-* npm packages belong to OpenLayers.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@mitodl/**"
      ],
      "minimumReleaseAge": null
    }
  ],
  "pip-compile": {
    "fileMatch": [
      "(^|/).*?requirements.*?\\.txt$"
    ]
  }
}
