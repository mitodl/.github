{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assigneesFromCodeOwners": true,
  "extends": [
    ":automergeMinor",
    ":rebaseStalePrs",
    ":separateMajorReleases",
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "7 days"
  },
  "schedule": [
    "every weekend"
  ],
  "timezone": "US/Eastern",
  "gitIgnoredAuthors": [
    "114827586+autofix-ci[bot]@users.noreply.github.com"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "(^|/)prek\\.toml$"
      ],
      "matchStrings": [
        "repo\\s*=\\s*[\"']https://github\\.com/(?<depName>[^\"']+)[\"'][\\s\\S]*?rev\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "Earthfile",
        "*.Dockerfile",
        "Dockerfile.*",
        "*.dockerfile"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "automerge": false
    },
    {
      "groupName": "all non-major dev-dependencies",
      "groupSlug": "all-minor-dev-patch",
      "matchPackagePatterns": [
        "*"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchSourceUrlPrefixes": [
        "https://github.com/ckeditor/ckeditor5/"
      ],
      "groupName": "ckeditor5"
    },
    {
      "matchPackageNames": [
        "xmlsec"
      ],
      "allowedVersions": "!/1\\.3\\.14/",
      "automerge": false
    },
    {
      "matchPackageNames": [
        "python"
      ],
      "automerge": false
    },
    {
      "description": "Our own PyPI packages skip the release-age wait, so apps pick up our fixes as soon as they are released. Exact names, not ol-*/mitol-* globs: anyone can register a matching name on PyPI. The list is every PyPI project the mitx-devops account owns, minus stale ones; each repo's [tool.uv.exclude-newer-package] list must also name a package for uv to accept it.",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "django-aqueduct",
        "edx-api-client",
        "edx-sga",
        "edx-sysadmin",
        "edx-username-changer",
        "mitol-django-apigateway",
        "mitol-django-authentication",
        "mitol-django-benchmark",
        "mitol-django-common",
        "mitol-django-digital-credentials",
        "mitol-django-geoip",
        "mitol-django-google-sheets",
        "mitol-django-google-sheets-deferrals",
        "mitol-django-google-sheets-refunds",
        "mitol-django-hubspot-api",
        "mitol-django-keycloak",
        "mitol-django-mail",
        "mitol-django-oauth-toolkit-extensions",
        "mitol-django-observability",
        "mitol-django-olposthog",
        "mitol-django-openedx",
        "mitol-django-payment-gateway",
        "mitol-django-scim",
        "mitol-django-transcoding",
        "mitol-drf-lint",
        "ol-agent-kit",
        "ol-concourse",
        "ol-llm",
        "ol-openedx-ai-static-translations",
        "ol-openedx-auto-select-language",
        "ol-openedx-canvas-integration",
        "ol-openedx-chat",
        "ol-openedx-chat-xblock",
        "ol-openedx-checkout-external",
        "ol-openedx-course-export",
        "ol-openedx-course-outline-api",
        "ol-openedx-course-structure-api",
        "ol-openedx-course-sync",
        "ol-openedx-course-translations",
        "ol-openedx-events-handler",
        "ol-openedx-feedback",
        "ol-openedx-git-auto-export",
        "ol-openedx-logging",
        "ol-openedx-lti-utilities",
        "ol-openedx-otel-monitoring",
        "ol-openedx-rapid-response-reports",
        "ol-openedx-sentry",
        "ol-openedx-uai-content-customization",
        "ol-parliament",
        "ol-social-auth",
        "open-learning-ai-tutor",
        "openedx-companion-auth",
        "rapid-response-xblock",
        "witan-code",
        "witan-core",
        "witan-council"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Our own npm packages skip the release-age wait: the @mitodl scope, which only our org can publish to, plus the unscoped packages the mitx-devops account maintains.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@mitodl/**",
        "eslint-config-mitodl",
        "redux-asserts",
        "redux-hammock"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "A Docker digest update is the same tag rebuilt, usually for OS patches. Images such as nginx and mitodl/ol-python-base are rebuilt within a week, so the release-age wait would never clear.",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Renovate often gets no release date for Docker tags, and timestamp-required (the default) treats an undated release as never old enough; in mitxonline, mitxpro and lehrer that held back every Docker update. Undated Docker releases count as old enough instead; dated ones still wait.",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Our own images skip the release-age wait: we build them, and the mitodl Docker Hub namespace only our org can push to.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mitodl/**"
      ],
      "minimumReleaseAge": null
    }
  ],
  "pip-compile": {
    "fileMatch": [
      "(^|/).*?requirements.*?\\.txt$"
    ]
  }
}
